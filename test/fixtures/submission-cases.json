      "expect": { "ok": true } },
    { "id": "name-not-string", "knownIds": null,
      "input": { "name": 5, "prompt": "x", "tags": ["翻译"] },
      "expect": { "ok": false, "errors": [{ "field": "name", "code": "bad_type" }] } },
