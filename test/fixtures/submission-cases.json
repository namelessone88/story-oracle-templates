      "expect": { "ok": true, "value": { "name": "去AI味·轻量版", "prompt": "只改腔调。", "author": "海盐柠檬", "description": "适合长回复", "tags": ["去AI味", "精简"], "model": "DeepSeek V4", "updateOf": null, "client": "1.86.0" } } },
    { "id": "single-line-fields-collapse", "knownIds": null,
