      "expect": { "ok": true, "value": { "name": "a", "prompt": "b", "author": "", "description": "", "tags": ["其他"], "model": "", "updateOf": null, "client": "" } } },
    { "id": "name-blank", "knownIds": null,
      "input": { "name": "   ", "prompt": "x", "tags": ["翻译"] },
      "expect": { "ok": false, "errors": [{ "field": "name", "code": "required" }] } },
    { "id": "name-40-ok", "knownIds": null,
      "input": { "name": { "$repeat": ["字", 40] }, "prompt": "x", "tags": ["翻译"] },
