    { "id": "name-41", "knownIds": null,
      "input": { "name": { "$repeat": ["字", 41] }, "prompt": "x", "tags": ["翻译"] },
      "expect": { "ok": false, "errors": [{ "field": "name", "code": "too_long" }] } },
